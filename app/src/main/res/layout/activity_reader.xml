<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/reader_backdrop">

    <top.teamaos.pdfreader.view.PdfView
        android:id="@+id/pdfView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!--
      Narrow on purpose. A full-width version made every fade frame a full-screen composite and
      wrecked scrolling; the page-number bubble is the separate view below instead.
    -->
    <top.teamaos.pdfreader.view.FastScrollBar
        android:id="@+id/fastScroll"
        android:layout_width="40dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_marginTop="64dp"
        android:layout_marginBottom="96dp" />

    <!-- Page and progress while the handle is being dragged. -->
    <TextView
        android:id="@+id/scrollBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginEnd="66dp"
        android:background="@drawable/bg_page_pill"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
        android:textColor="#FFFFFFFF"
        android:visibility="gone" />

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/bg_reader_header"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleMedium" />

    <!-- Replaces the toolbar while a search is running. -->
    <LinearLayout
        android:id="@+id/searchBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/bg_reader_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/searchCloseButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cancel"
            android:src="@drawable/ic_arrow_back"
            app:tint="#FFFFFFFF" />

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/search_in_document"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#80FFFFFF" />

        <TextView
            android:id="@+id/searchCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            android:alpha="0.8"
            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
            android:textColor="#FFFFFFFF" />

        <ImageButton
            android:id="@+id/searchPrevButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/search_previous"
            android:src="@drawable/ic_arrow_up"
            app:tint="#FFFFFFFF" />

        <ImageButton
            android:id="@+id/searchNextButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/search_next"
            android:src="@drawable/ic_arrow_down"
            app:tint="#FFFFFFFF" />
    </LinearLayout>

    <!--
      The reading bar: where you are, then what you can do, on one line.

      The row lives in a scroll host. Every control names itself underneath its icon and a named
      control is about 50dp wide, so five of them plus the page pill is a little more than a narrow
      phone has — the row slides rather than losing its last button off the edge.
    -->
    <LinearLayout
        android:id="@+id/bottomBarScroller"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginHorizontal="6dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_floating_toolbar"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="6dp"
        android:paddingTop="4dp"
        android:paddingBottom="3dp">

        <HorizontalScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/bottomBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- "7 / 56" alone did not say what it counted; the small word under it does. -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/pageIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_page_pill"
                        android:maxLines="1"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                        android:textColor="#FFFFFFFF" />

                    <TextView
                        style="@style/ReaderBarLabel"
                        android:text="@string/label_page" />
                </LinearLayout>

                <TextView
                    android:id="@+id/statusText"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="5dp"
                    android:alpha="0.75"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                    android:textColor="#FFFFFFFF" />

                <LinearLayout
                    android:id="@+id/zoomButton"
                    style="@style/ReaderBarButton"
                    android:contentDescription="@string/action_zoom">

                    <ImageView
                        style="@style/ReaderBarIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_zoom_in"
                        app:tint="#FFFFFFFF" />

                    <TextView
                        style="@style/ReaderBarLabel"
                        android:text="@string/label_zoom" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/viewModeButton"
                    style="@style/ReaderBarButton"
                    android:contentDescription="@string/action_view_mode">

                    <ImageView
                        android:id="@+id/viewModeIcon"
                        style="@style/ReaderBarIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_view_day"
                        app:tint="#FFFFFFFF" />

                    <TextView
                        style="@style/ReaderBarLabel"
                        android:text="@string/label_view" />
                </LinearLayout>

                <!--
                  Screen orientation and the reading lock sit on the bar itself, not behind the
                  menu: you reach for them mid-read, one-handed, and a two-tap detour through a
                  popup is exactly the wrong shape for that.
                -->
                <LinearLayout
                    android:id="@+id/orientationButton"
                    style="@style/ReaderBarButton"
                    android:contentDescription="@string/action_orientation">

                    <ImageView
                        android:id="@+id/orientationIcon"
                        style="@style/ReaderBarIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_screen_auto"
                        app:tint="#FFFFFFFF" />

                    <TextView
                        style="@style/ReaderBarLabel"
                        android:text="@string/label_screen" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/lockButton"
                    style="@style/ReaderBarButton"
                    android:contentDescription="@string/action_lock">

                    <ImageView
                        style="@style/ReaderBarIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_lock_open"
                        app:tint="#FFFFFFFF" />

                    <TextView
                        style="@style/ReaderBarLabel"
                        android:text="@string/label_lock" />
                </LinearLayout>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Second row: the reading tools, each with its name under it. A row of their own keeps
             the page number and view controls from being pushed off the side, and the row scrolls
             sideways on a narrow phone rather than squeezing the labels. -->
        <HorizontalScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/toolRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/toolContentsButton"
                    style="@style/ReaderBarButton"
                    android:contentDescription="@string/action_outline">

                    <ImageView
                        style="@style/ReaderBarIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_list"
                        app:tint="#FFFFFFFF" />

                    <TextView
                        style="@style/ReaderBarLabel"
                        android:text="@string/label_contents" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/toolThumbnailsButton"
                    style="@style/ReaderBarButton"
                    android:contentDescription="@string/action_thumbnails">

                    <ImageView
                        style="@style/ReaderBarIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_grid"
                        app:tint="#FFFFFFFF" />

                    <TextView
                        style="@style/ReaderBarLabel"
                        android:text="@string/label_pages" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/toolEditButton"
                    style="@style/ReaderBarButton"
                    android:contentDescription="@string/action_edit_pages">

                    <ImageView
                        style="@style/ReaderBarIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_edit"
                        app:tint="#FFFFFFFF" />

                    <TextView
                        style="@style/ReaderBarLabel"
                        android:text="@string/label_edit" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/toolBrushButton"
                    style="@style/ReaderBarButton"
                    android:contentDescription="@string/action_draw">

                    <ImageView
                        style="@style/ReaderBarIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_brush"
                        app:tint="#FFFFFFFF" />

                    <TextView
                        style="@style/ReaderBarLabel"
                        android:text="@string/label_brush" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/toolColourButton"
                    style="@style/ReaderBarButton"
                    android:contentDescription="@string/action_colour_mode">

                    <ImageView
                        style="@style/ReaderBarIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_dark_mode"
                        app:tint="#FFFFFFFF" />

                    <TextView
                        style="@style/ReaderBarLabel"
                        android:text="@string/label_colour" />
                </LinearLayout>

            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Page editing: replaces the reading toolbar while pages are being selected. -->
    <LinearLayout
        android:id="@+id/editBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginHorizontal="8dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_floating_toolbar"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="6dp"
        android:paddingTop="7dp"
        android:paddingBottom="3dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/selectionCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
            android:textColor="#FFFFFFFF" />

        <HorizontalScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- First in the bar, so leaving an accidental long-press is the obvious move. -->
                <LinearLayout
                    android:id="@+id/editCancelButton"
                    style="@style/ReaderBarButton"
                    android:contentDescription="@string/cancel">

                    <ImageView
                        style="@style/ReaderBarIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_close"
                        app:tint="#FFFFFFFF" />

                    <TextView
                        style="@style/ReaderBarLabel"
                        android:text="@string/cancel" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rotateLeftButton"
                    style="@style/ReaderBarButton"
                    android:contentDescription="@string/rotate_left">

                    <ImageView
                        style="@style/ReaderBarIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_rotate_left"
                        app:tint="#FFFFFFFF" />

                    <TextView
                        style="@style/ReaderBarLabel"
                        android:text="@string/label_rotate_left" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rotateRightButton"
                    style="@style/ReaderBarButton"
                    android:contentDescription="@string/rotate_right">

                    <ImageView
                        style="@style/ReaderBarIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_rotate_right"
                        app:tint="#FFFFFFFF" />

                    <TextView
                        style="@style/ReaderBarLabel"
                        android:text="@string/label_rotate_right" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cropButton"
                    style="@style/ReaderBarButton"
                    android:contentDescription="@string/action_crop">

                    <ImageView
                        style="@style/ReaderBarIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_crop"
                        app:tint="#FFFFFFFF" />

                    <TextView
                        style="@style/ReaderBarLabel"
                        android:text="@string/label_crop" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/drawButton"
                    style="@style/ReaderBarButton"
                    android:contentDescription="@string/action_draw">

                    <ImageView
                        style="@style/ReaderBarIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_brush"
                        app:tint="#FFFFFFFF" />

                    <TextView
                        style="@style/ReaderBarLabel"
                        android:text="@string/label_brush" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/splitButton"
                    style="@style/ReaderBarButton"
                    android:contentDescription="@string/action_split">

                    <ImageView
                        style="@style/ReaderBarIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_split"
                        app:tint="#FFFFFFFF" />

                    <TextView
                        style="@style/ReaderBarLabel"
                        android:text="@string/label_split" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/selectAllButton"
                    style="@style/ReaderBarButton"
                    android:contentDescription="@string/action_select_all">

                    <ImageView
                        style="@style/ReaderBarIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_select_all"
                        app:tint="#FFFFFFFF" />

                    <TextView
                        android:id="@+id/selectAllLabel"
                        style="@style/ReaderBarLabel"
                        android:text="@string/label_select_all" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/extractButton"
                    style="@style/ReaderBarButton"
                    android:contentDescription="@string/action_extract">

                    <ImageView
                        style="@style/ReaderBarIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_share"
                        app:tint="#FFFFFFFF" />

                    <TextView
                        style="@style/ReaderBarLabel"
                        android:text="@string/label_new_pdf" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/editUndoButton"
                    style="@style/ReaderBarButton"
                    android:contentDescription="@string/label_undo">

                    <ImageView
                        style="@style/ReaderBarIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_undo"
                        app:tint="#FFFFFFFF" />

                    <TextView
                        style="@style/ReaderBarLabel"
                        android:text="@string/label_undo" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/editRedoButton"
                    style="@style/ReaderBarButton"
                    android:contentDescription="@string/label_redo">

                    <ImageView
                        style="@style/ReaderBarIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_redo"
                        app:tint="#FFFFFFFF" />

                    <TextView
                        style="@style/ReaderBarLabel"
                        android:text="@string/label_redo" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/editDoneButton"
                    style="@style/ReaderBarButton"
                    android:contentDescription="@string/action_done">

                    <ImageView
                        style="@style/ReaderBarIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_check"
                        app:tint="#FF7FC0FF" />

                    <TextView
                        style="@style/ReaderBarLabel"
                        android:text="@string/action_done" />
                </LinearLayout>
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!--
      Smooth zoom. The slider is logarithmic — its value is log2(zoom) — so 100% sits in the middle
      of the track and the same finger movement doubles or halves the scale wherever you are.

      Fit is a labelled button on the row, not a word tucked past the right edge. It used to be the
      last thing in a row that came to more than a narrow phone is wide, which meant the one
      control that undoes a bad zoom was the one falling off the screen.
    -->
    <LinearLayout
        android:id="@+id/zoomSliderBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="112dp"
        android:background="@drawable/bg_floating_toolbar"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="3dp"
        android:visibility="gone">

        <!-- The slider gets a whole row to itself: squeezed in beside the buttons it was too short
             to set a zoom with any precision. -->
        <com.google.android.material.slider.Slider
            android:id="@+id/zoomSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="0"
            android:valueFrom="-2.0"
            android:valueTo="3.0"
            app:labelBehavior="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/zoomOutButton"
                style="@style/ReaderBarButton"
                android:contentDescription="@string/zoom_out">

                <ImageView
                    style="@style/ReaderBarIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_zoom_out"
                    app:tint="#FFFFFFFF" />

                <TextView
                    style="@style/ReaderBarLabel"
                    android:text="@string/label_zoom_out" />
            </LinearLayout>

            <TextView
                android:id="@+id/zoomPercent"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="#FFFFFFFF" />

            <LinearLayout
                android:id="@+id/zoomInButton"
                style="@style/ReaderBarButton"
                android:contentDescription="@string/zoom_in">

                <ImageView
                    style="@style/ReaderBarIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_zoom_in"
                    app:tint="#FFFFFFFF" />

                <TextView
                    style="@style/ReaderBarLabel"
                    android:text="@string/label_zoom_in" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/zoomResetButton"
                style="@style/ReaderBarButton"
                android:contentDescription="@string/zoom_fit">

                <ImageView
                    style="@style/ReaderBarIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_fit_page"
                    app:tint="#FF7FC0FF" />

                <TextView
                    style="@style/ReaderBarLabel"
                    android:text="@string/zoom_fit"
                    android:textColor="#FF7FC0FF" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!--
      The brush bar.

      Two tight rows. On top, what you pick once and leave: the colour and the size, with the slider
      given the whole remaining width so a size can actually be set. Below, the tools pressed all the
      time, grouped — what you draw with, taking it back, what happens to the marks — and a solid
      Done button that cannot be mistaken for one of them. Every tool keeps its name under its icon.
    -->
    <LinearLayout
        android:id="@+id/drawBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginHorizontal="10dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_draw_panel"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="2dp">

            <LinearLayout
                android:id="@+id/colourRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal" />

            <View style="@style/DrawBarDivider" android:layout_height="20dp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/brushSizeSlider"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="@string/brush_size_description"
                android:stepSize="1"
                android:value="14"
                android:valueFrom="2"
                android:valueTo="60"
                app:labelBehavior="gone"
                app:thumbRadius="7dp"
                app:trackHeight="3dp" />

            <TextView
                android:id="@+id/brushSizeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_page_pill"
                android:gravity="center"
                android:minWidth="40dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="3dp"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="#FFFFFFFF" />

            <!-- A plain way out, where people look for one: the corner. -->
            <ImageButton
                android:id="@+id/drawCloseButton"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/draw_close"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close"
                app:tint="#FFFFFFFF" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="6dp"
            android:background="@drawable/bg_bar_divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/moveButton"
                style="@style/DrawToolButton"
                android:background="@drawable/bg_tool_toggle"
                android:contentDescription="@string/move_description">

                <ImageView
                    android:id="@+id/moveIcon"
                    style="@style/ReaderBarIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_pan"
                    app:tint="#FFFFFFFF" />

                <TextView
                    android:id="@+id/moveLabel"
                    style="@style/ReaderBarLabel"
                    android:text="@string/label_move" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/brushButton"
                style="@style/DrawToolButton"
                android:background="@drawable/bg_tool_toggle"
                android:contentDescription="@string/label_brush">

                <ImageView
                android:id="@+id/brushIcon"
                    style="@style/ReaderBarIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_brush"
                    app:tint="#FF7FC0FF" />

                <TextView
                android:id="@+id/brushLabel"
                    style="@style/ReaderBarLabel"
                    android:text="@string/label_brush" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/eraserButton"
                style="@style/DrawToolButton"
                android:background="@drawable/bg_tool_toggle"
                android:contentDescription="@string/label_eraser">

                <ImageView
                android:id="@+id/eraserIcon"
                    style="@style/ReaderBarIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_eraser"
                    app:tint="#FFFFFFFF" />

                <TextView
                android:id="@+id/eraserLabel"
                    style="@style/ReaderBarLabel"
                    android:text="@string/label_eraser" />
            </LinearLayout>
            <View style="@style/DrawBarDivider" />
            <LinearLayout
                android:id="@+id/undoButton"
                style="@style/DrawToolButton"
                android:contentDescription="@string/label_undo">

                <ImageView
                    style="@style/ReaderBarIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_undo"
                    app:tint="#FFFFFFFF" />

                <TextView
                    style="@style/ReaderBarLabel"
                    android:text="@string/label_undo" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/redoButton"
                style="@style/DrawToolButton"
                android:contentDescription="@string/label_redo">

                <ImageView
                    style="@style/ReaderBarIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_redo"
                    app:tint="#FFFFFFFF" />

                <TextView
                    style="@style/ReaderBarLabel"
                    android:text="@string/label_redo" />
            </LinearLayout>
            <View style="@style/DrawBarDivider" />
            <LinearLayout
                android:id="@+id/clearMarksButton"
                style="@style/DrawToolButton"
                android:contentDescription="@string/label_clear">

                <ImageView
                    style="@style/ReaderBarIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_clear_all"
                    app:tint="#FFFFFFFF" />

                <TextView
                    style="@style/ReaderBarLabel"
                    android:text="@string/label_clear" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/burnMarksButton"
                style="@style/DrawToolButton"
                android:contentDescription="@string/marks_burn">

                <ImageView
                    style="@style/ReaderBarIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_save"
                    app:tint="#FFFFFFFF" />

                <TextView
                    style="@style/ReaderBarLabel"
                    android:text="@string/label_burn" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/drawDoneButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_done_pill"
                android:clickable="true"
                android:contentDescription="@string/action_done"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_check"
                    app:tint="#FFFFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/action_done"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textColor="#FFFFFFFF" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!--
      What to do with selected text. Appears only while something is selected, and sits at the
      bottom rather than floating over the words, which on a phone would cover the very line the
      reader just picked out.
    -->
    <LinearLayout
        android:id="@+id/textActionBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginHorizontal="8dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_floating_toolbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:paddingTop="5dp"
        android:paddingBottom="3dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/textCopyButton"
            style="@style/ReaderBarButton"
            android:contentDescription="@string/text_copy">

            <ImageView
                style="@style/ReaderBarIcon"
                android:contentDescription="@null"
                android:src="@drawable/ic_copy"
                app:tint="#FFFFFFFF" />

            <TextView
                style="@style/ReaderBarLabel"
                android:text="@string/text_copy" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/textSelectAllButton"
            style="@style/ReaderBarButton"
            android:contentDescription="@string/text_select_all">

            <ImageView
                style="@style/ReaderBarIcon"
                android:contentDescription="@null"
                android:src="@drawable/ic_select_all"
                app:tint="#FFFFFFFF" />

            <TextView
                style="@style/ReaderBarLabel"
                android:text="@string/label_select_all" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/textFindButton"
            style="@style/ReaderBarButton"
            android:contentDescription="@string/text_find">

            <ImageView
                style="@style/ReaderBarIcon"
                android:contentDescription="@null"
                android:src="@drawable/ic_search"
                app:tint="#FFFFFFFF" />

            <TextView
                style="@style/ReaderBarLabel"
                android:text="@string/text_find" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/textTranslateButton"
            style="@style/ReaderBarButton"
            android:contentDescription="@string/text_translate">

            <ImageView
                style="@style/ReaderBarIcon"
                android:contentDescription="@null"
                android:src="@drawable/ic_translate"
                app:tint="#FFFFFFFF" />

            <TextView
                style="@style/ReaderBarLabel"
                android:text="@string/text_translate" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/textShareButton"
            style="@style/ReaderBarButton"
            android:contentDescription="@string/action_share">

            <ImageView
                style="@style/ReaderBarIcon"
                android:contentDescription="@null"
                android:src="@drawable/ic_share"
                app:tint="#FFFFFFFF" />

            <TextView
                style="@style/ReaderBarLabel"
                android:text="@string/text_share" />
        </LinearLayout>
    </LinearLayout>

    <!--
      Cropping. The frame covers the whole screen so the dimmed area reads as one piece, and it
      sits above the reader so the page underneath cannot be scrolled out from under the frame
      halfway through choosing it.
    -->
    <FrameLayout
        android:id="@+id/cropLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <top.teamaos.pdfreader.view.CropOverlay
            android:id="@+id/cropOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/cropTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="96dp"
            android:background="@drawable/bg_page_pill"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="@string/crop_title"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:textColor="#FFFFFFFF" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginHorizontal="8dp"
            android:layout_marginBottom="28dp"
            android:background="@drawable/bg_floating_toolbar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp"
            android:paddingTop="5dp"
            android:paddingBottom="3dp">

            <LinearLayout
                android:id="@+id/cropCancelButton"
                style="@style/ReaderBarButton"
                android:contentDescription="@string/cancel">

                <ImageView
                    style="@style/ReaderBarIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_close"
                    app:tint="#FFFFFFFF" />

                <TextView
                    style="@style/ReaderBarLabel"
                    android:text="@string/cancel" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cropResetButton"
                style="@style/ReaderBarButton"
                android:contentDescription="@string/crop_reset">

                <ImageView
                    style="@style/ReaderBarIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_fit_page"
                    app:tint="#FFFFFFFF" />

                <TextView
                    style="@style/ReaderBarLabel"
                    android:text="@string/crop_reset" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cropApplyButton"
                style="@style/ReaderBarButton"
                android:contentDescription="@string/action_crop">

                <ImageView
                    style="@style/ReaderBarIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_crop"
                    app:tint="#FF7FC0FF" />

                <TextView
                    android:id="@+id/cropApplyLabel"
                    style="@style/ReaderBarLabel"
                    android:text="@string/label_crop"
                    android:textColor="#FF7FC0FF" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <ImageButton
        android:id="@+id/unlockButton"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        android:alpha="0.55"
        android:background="@drawable/bg_circle_button"
        android:contentDescription="@string/action_unlock"
        android:src="@drawable/ic_lock"
        android:visibility="gone"
        app:tint="#FFFFFFFF" />

    <TextView
        android:id="@+id/pageChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_page_pill"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
        android:textColor="#FFFFFFFF"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/reader_backdrop">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true" />
    </FrameLayout>

    <TextView
        android:id="@+id/errorView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="32dp"
        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
        android:textColor="#FFFFFFFF"
        android:visibility="gone" />
</FrameLayout>
