<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher background. A flat colour reads as unfinished next to the icons it sits beside, so
  this is the same blue-to-violet sweep the app's header uses, with one lighter diagonal across it
  to catch the eye without turning into a pattern.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:color="#FF1B63C4" android:offset="0" />
                <item android:color="#FF3F53C8" android:offset="0.5" />
                <item android:color="#FF6C3FC0" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <path
        android:fillAlpha="0.16"
        android:fillColor="#FFFFFFFF"
        android:pathData="M0,74 L108,14 L108,44 L0,104 z" />
</vector>
