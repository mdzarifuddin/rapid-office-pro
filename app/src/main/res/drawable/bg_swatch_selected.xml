<?xml version="1.0" encoding="utf-8"?>
<!-- The chosen colour gets a ring around it, which reads at a glance on a dark bar. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke android:width="2.5dp" android:color="#FF7FC0FF" />
        </shape>
    </item>
    <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
            <stroke android:width="1dp" android:color="#66000000" />
        </shape>
    </item>
</layer-list>
