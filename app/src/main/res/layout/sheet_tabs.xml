<?xml version="1.0" encoding="utf-8"?>
<!--
  Hangs off the top of the screen rather than rising from the bottom: the button that opens it is
  in the header, and a panel that appears where your thumb just was reads as the same object
  continuing, not a second one arriving from the far end of the phone.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/bg_top_sheet"
        android:orientation="vertical"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/sheetTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:text="@string/tabs_title"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tabList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="380dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/openAnotherButton"
            style="@style/Widget.Material3.Button.TextButton.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            android:text="@string/open_another"
            app:icon="@drawable/ic_add" />

        <!-- The grabber sits at the bottom edge, which is the edge this panel is dragged from. -->
        <View
            android:layout_width="34dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="2dp"
            android:background="@drawable/bg_sheet_grabber" />
    </LinearLayout>
</FrameLayout>
