<?xml version="1.0" encoding="utf-8"?>
<!-- The reader's own header: the same sweep, darkened so a white page beside it stays the brightest thing. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="0"
        android:startColor="@color/reader_header_start"
        android:centerColor="@color/reader_header_middle"
        android:endColor="@color/reader_header_end"
        android:type="linear" />
</shape>
